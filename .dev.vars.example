# Backend only. Copy to .dev.vars and set the project's real values.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-server-secret-key"
JWT_SECRET="replace-with-a-long-random-guest-signing-secret"
# Optional for viewers on networks where direct WebRTC is blocked. Configure a
# TURN service you own; this JSON is delivered only to authenticated room users.
# RTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:YOUR_TURN_HOST:5349","username":"YOUR_USER","credential":"YOUR_CREDENTIAL"}]'
